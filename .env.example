# Control plane
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Leave blank for an in-memory local demo; set this to PostgreSQL for durable state.
DATABASE_URL=
AGENT_URL=http://127.0.0.1:4318
AGENT_HOST=127.0.0.1
AGENT_ENROLLMENT_TOKEN=change-me
# Fastest local test mode; switch to docker for real Compose operations.
FIXOPS_AGENT_MODE=mock
# In mock mode this resets the native demo after a simulated restart.
FIXOPS_MOCK_RESET_URL=http://127.0.0.1:4100/api/reset
FIXOPS_DATA_DIR=.fixops-data
FIXOPS_WORKSPACE_ROOT=.fixops-workspaces
PUBLIC_BASE_URL=http://localhost:3000

# Optional server-side defaults for any OpenAI/ChatGPT-compatible gateway.
# Leave these empty when each project supplies its own AI settings through the API.
# For Happy API, enter its compatible /v1 base URL, token, model and app name in the project settings.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_APP_NAME=
AI_APP_URL=
AI_ORGANIZATION=

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (optional; the web console stores in-app notifications by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FixOps <fixops@example.com>

# Safety
# Set true only when the control plane is behind a private network/reverse proxy.
ALLOW_INSECURE_REMOTE=true
MAX_REMEDIATION_MINUTES=15
MAX_REMEDIATION_STEPS=12
